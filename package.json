{
  "name": "planningcenter-timer-kiosk",
  "version": "2026.8.5-beta.2",
  "private": true,
  "description": "Kiosk controller that drives a Planning Center Services live/countdown page in a Chromium kiosk via CDP",
  "license": "AGPL-3.0",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "kiosk": "node kiosk/launch-kiosk.js",
    "kiosk:login": "node kiosk/launch-kiosk.js --login",
    "test": "node --test",
    "dev:panel": "vite --config panel/vite.config.ts",
    "build:panel": "vite build --config panel/vite.config.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chrome-remote-interface": "^0.33.0",
    "cron-parser": "^5.7.0",
    "express": "^4.21.2",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "ws": "^8.18.0"
  }
}
